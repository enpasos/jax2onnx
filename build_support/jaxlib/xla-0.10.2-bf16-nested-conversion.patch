+// The direct-backend case retains scalar map calls. The full-pipeline case
+// verifies normal optimization/code generation. Neither changes target features,
+// process flags, FENV, or the original application/TopK acceptance tests.
+class NestedBf16ConversionTest : public HloPjRtTestBase,
+                                 public ::testing::WithParamInterface<bool> {};
+
+TEST_P(NestedBf16ConversionTest, NarrowingHasExactRneWords) {
+  const char* hlo = R"hlo(
+HloModule nested_bf16_narrow
+
+narrow {
+  bits = u32[] parameter(0)
+  input = f32[] bitcast-convert(bits)
+  narrowed = bf16[] convert(input)
+  ROOT result = u16[] bitcast-convert(narrowed)
+}
+
+ENTRY main {
+  bits = u32[45] parameter(0)
+  ROOT result = u16[45] map(bits), dimensions={0}, to_apply=narrow
+}
+)hlo";
+  auto input = LiteralUtil::CreateR1<uint32_t>({
+      0x00000000, 0x80000000, 0x00000001, 0x80000001,
+      0x00007fff, 0x00008000, 0x00008001, 0x80008000,
+      0x80008001, 0x00010000, 0x80010000, 0x00018000,
+      0x80018000, 0x00020000, 0x007f0000, 0x807f0000,
+      0x007f7fff, 0x007f8000, 0x807f8000, 0x007fffff,
+      0x00800000, 0x80800000, 0x00808000, 0x00818000,
+      0x3f800000, 0x3f807fff, 0x3f808000, 0x3f808001,
+      0x3f818000, 0xbf808000, 0xbf808001, 0xbf818000,
+      0x7f7f0000, 0xff7f0000, 0x7f7f7fff, 0x7f7f8000,
+      0xff7f8000, 0x7f800000, 0xff800000, 0x7f800001,
+      0x7fc12345, 0x7fffffff, 0xff800001, 0xffc12345,
+      0xffffffff});
+  TF_ASSERT_OK_AND_ASSIGN(auto module, ParseAndReturnVerifiedModule(hlo));
+  TF_ASSERT_OK_AND_ASSIGN(auto result,
+                          Execute(std::move(module), {&input}, GetParam()));
+  // Fixed IEEE nearest-even words, including both signs of subnormal boundaries,
+  // exact halfway cases, signed zero, overflow, and existing canonical quiet NaNs.
+  LiteralTestUtil::ExpectR1Equal<uint16_t>({
+      0x0000, 0x8000, 0x0000, 0x8000,
+      0x0000, 0x0000, 0x0001, 0x8000,
+      0x8001, 0x0001, 0x8001, 0x0002,
+      0x8002, 0x0002, 0x007f, 0x807f,
+      0x007f, 0x0080, 0x8080, 0x0080,
+      0x0080, 0x8080, 0x0080, 0x0082,
+      0x3f80, 0x3f80, 0x3f80, 0x3f81,
+      0x3f82, 0xbf80, 0xbf81, 0xbf82,
+      0x7f7f, 0xff7f, 0x7f7f, 0x7f80,
+      0xff80, 0x7f80, 0xff80, 0x7fc0,
+      0x7fc0, 0x7fc0, 0xffc0, 0xffc0,
+      0xffc0}, result);
+}
+
+TEST_P(NestedBf16ConversionTest, WideningHasExactWords) {
+  const char* hlo = R"hlo(
+HloModule nested_bf16_widen
+
+widen {
+  bits = u16[] parameter(0)
+  input = bf16[] bitcast-convert(bits)
+  widened = f32[] convert(input)
+  ROOT result = u32[] bitcast-convert(widened)
+}
+
+ENTRY main {
+  bits = u16[22] parameter(0)
+  ROOT result = u32[22] map(bits), dimensions={0}, to_apply=widen
+}
+)hlo";
+  auto input = LiteralUtil::CreateR1<uint16_t>({
+      0x0000, 0x8000, 0x0001, 0x8001,
+      0x0002, 0x8002, 0x007f, 0x807f,
+      0x0080, 0x8080, 0x3f80, 0xbf80,
+      0x7f7f, 0xff7f, 0x7f80, 0xff80,
+      0x7f81, 0xff81, 0x7fc1, 0xffc1,
+      0x7fff, 0xffff});
+  TF_ASSERT_OK_AND_ASSIGN(auto module, ParseAndReturnVerifiedModule(hlo));
+  TF_ASSERT_OK_AND_ASSIGN(auto result,
+                          Execute(std::move(module), {&input}, GetParam()));
+  LiteralTestUtil::ExpectR1Equal<uint32_t>({
+      0x00000000, 0x80000000, 0x00010000, 0x80010000,
+      0x00020000, 0x80020000, 0x007f0000, 0x807f0000,
+      0x00800000, 0x80800000, 0x3f800000, 0xbf800000,
+      0x7f7f0000, 0xff7f0000, 0x7f800000, 0xff800000,
+      0x7f810000, 0xff810000, 0x7fc10000, 0xffc10000,
+      0x7fff0000, 0xffff0000}, result);
+}
+
+TEST_P(NestedBf16ConversionTest, ComparatorPreservesWordsAndStableOrdering) {
+  const char* hlo = R"hlo(
+HloModule nested_bf16_sort
+
+compare {
+  lhs = f32[] parameter(0)
+  rhs = f32[] parameter(1)
+  lhs_index = s32[] parameter(2)
+  rhs_index = s32[] parameter(3)
+  lhs_bf16 = bf16[] convert(lhs)
+  rhs_bf16 = bf16[] convert(rhs)
+  lhs_bits = s16[] bitcast-convert(lhs_bf16)
+  rhs_bits = s16[] bitcast-convert(rhs_bf16)
+  zero = s16[] constant(0)
+  mask = s16[] constant(32767)
+  lhs_negative = pred[] compare(lhs_bits, zero), direction=LT
+  rhs_negative = pred[] compare(rhs_bits, zero), direction=LT
+  lhs_flipped = s16[] xor(lhs_bits, mask)
+  rhs_flipped = s16[] xor(rhs_bits, mask)
+  lhs_key = s16[] select(lhs_negative, lhs_flipped, lhs_bits)
+  rhs_key = s16[] select(rhs_negative, rhs_flipped, rhs_bits)
+  ROOT greater = pred[] compare(lhs_key, rhs_key), direction=GT
+}
+
+ENTRY main {
+  input_bits = u32[9,4] parameter(0)
+  values = f32[9,4] bitcast-convert(input_bits)
+  indices = s32[9,4] iota(), iota_dimension=1
+  sorted = (f32[9,4], s32[9,4]) sort(values, indices), dimensions={1}, is_stable=true, to_apply=compare
+  sorted_values = f32[9,4] get-tuple-element(sorted), index=0
+  sorted_indices = s32[9,4] get-tuple-element(sorted), index=1
+  sorted_bits = u32[9,4] bitcast-convert(sorted_values)
+  ROOT result = (u32[9,4], s32[9,4]) tuple(sorted_bits, sorted_indices)
+}
+)hlo";
+  auto input = LiteralUtil::CreateR2<uint32_t>({
+      {0x00010000, 0x007f0000, 0x80010000, 0x807f0000},
+      {0x807f0000, 0x80010000, 0xbf800000, 0xbf800000},
+      {0x80010000, 0x807f0000, 0xbf800000, 0xbf800000},
+      {0x807f0000, 0x00010000, 0x80010000, 0x007f0000},
+      {0x80000000, 0x00000000, 0x80000000, 0x00000000},
+      {0x3f800000, 0x3f800000, 0x3f000000, 0xc0000000},
+      {0x7f800000, 0x7f7f0000, 0xff800000, 0xff7f0000},
+      {0x3f808000, 0x3f800000, 0x3f808001, 0x3f818000},
+      {0x7f800001, 0x7fc12345, 0xff800001, 0xffc12345}});
+  TF_ASSERT_OK_AND_ASSIGN(auto module, ParseAndReturnVerifiedModule(hlo));
+  TF_ASSERT_OK_AND_ASSIGN(auto result,
+                          Execute(std::move(module), {&input}, GetParam()));
+  auto outputs = result.DecomposeTuple();
+  ASSERT_EQ(outputs.size(), 2);
+  // The first row is the failing CI row widened exactly to F32. Negative and
+  // permuted rows expose artificial stable ties caused by flushing either sign.
+  // Return every original F32 payload bit, and require stable lower-index ties.
+  LiteralTestUtil::ExpectR2Equal<uint32_t>({
+      {0x007f0000, 0x00010000, 0x80010000, 0x807f0000},
+      {0x80010000, 0x807f0000, 0xbf800000, 0xbf800000},
+      {0x80010000, 0x807f0000, 0xbf800000, 0xbf800000},
+      {0x007f0000, 0x00010000, 0x80010000, 0x807f0000},
+      {0x00000000, 0x00000000, 0x80000000, 0x80000000},
+      {0x3f800000, 0x3f800000, 0x3f000000, 0xc0000000},
+      {0x7f800000, 0x7f7f0000, 0xff7f0000, 0xff800000},
+      {0x3f818000, 0x3f808001, 0x3f808000, 0x3f800000},
+      {0x7f800001, 0x7fc12345, 0xff800001, 0xffc12345}}, outputs[0]);
+  LiteralTestUtil::ExpectR2Equal<int32_t>({
+      {1, 0, 2, 3},
+      {1, 0, 2, 3},
+      {0, 1, 2, 3},
+      {3, 1, 2, 0},
+      {1, 3, 0, 2},
+      {0, 1, 2, 3},
+      {0, 1, 3, 2},
+      {3, 2, 0, 1},
+      {0, 1, 2, 3}}, outputs[1]);
+}
+
+INSTANTIATE_TEST_SUITE_P(HloPipeline, NestedBf16ConversionTest,
+                         ::testing::Bool());
